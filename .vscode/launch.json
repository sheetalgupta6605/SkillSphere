{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SkillSphere FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"]
    }
  ]
}
